# SnackFlow ERP - Environment Configuration Template
# Copy this file to .env and adjust variables as required

# Secret key for cryptographic signing of session cookies
SECRET_KEY=snackflow-production-secret-key-change-in-production

# Path to SQLite database file (defaults to data/oto.db)
DATABASE=data/oto.db

# Server Host and Port
HOST=0.0.0.0
PORT=5000

# Flask Environment mode (production / development)
FLASK_ENV=production
DEBUG=False
